

##
## ## Default Rule
##

default: help
.PHONY: default




##
## ## Help
##

help:
	@echo 'Usage:'
	@echo '	$$ make [action]'
	@echo
	@echo 'Example:'
	@echo '	$$ make'
	@echo '	$$ make help'
	@echo
	@echo '	$$ make to-bash'
	@echo
	@echo '	$$ make to-fish'
	@echo
	@echo '	$$ make to-zsh'
	@echo
.PHONY: help




##
## ## Change Shell
##

to-bash:
	@./to-bash.sh
.PHONY: to-bash


to-fish:
	@./to-fish.sh
.PHONY: to-fish


to-zsh:
	@./to-zsh.sh
.PHONY: to-zsh
